{
  "name": "@capacitor-community/firebase-analytics",
  "version": "9.0.0",
  "description": "A native plugin for firebase analytics.",
  "homepage": "https://github.com/capacitor-community/firebase-analytics",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "CAPACITOR_IOS_PATH=${CAPACITOR_IOS_PATH:-$(node -p \"require('path').dirname(require.resolve('@capacitor/ios/package.json'))\")} xcodebuild -scheme CapacitorCommunityFirebaseAnalytics -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run ktlint",
    "fmt": "npm run ktlint -- --format",
    "ktlint": "ktlint \"android/src/**/*.kt\"",
    "release": "np",
    "test": "echo \"No test specified\"",
    "ios:spm:install": "swift package resolve"
  },
  "author": "Capacitor Community",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "https://github.com/linuxul/capacitor/releases/download/9.0.0/capacitor-android-9.0.0.tgz",
    "@capacitor/core": "https://github.com/linuxul/capacitor/releases/download/9.0.0/capacitor-core-9.0.0.tgz",
    "@capacitor/ios": "https://github.com/linuxul/capacitor/releases/download/9.0.0/capacitor-ios-9.0.0.tgz",
    "husky": "^4.2.5",
    "np": "^7.6.2",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.0.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=9.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources/",
    "ios/Tests/",
    "CapacitorCommunityFirebaseAnalytics.podspec",
    "Package.swift"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/capacitor-community/firebase-analytics"
  },
  "bugs": {
    "url": "https://github.com/capacitor-community/firebase-analytics/issues"
  }
}

root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

# ktlint reads this section; the catch-all above would otherwise give Kotlin a two space indent.
[*.{kt,kts}]
ktlint_code_style = android_studio
indent_size = 4
max_line_length = 140
